rules_version = '2';

// ═══════════════════════════════════════════════════════════════
//  HEFTRENG — Firestore Security Rules  v6
//  Orijinal rules (v4) + Android app yeni koleksiyonları
//  Çakışma: YOK — orijinal kurallar değiştirilmedi, yalnızca
//  eksik koleksiyonlar eklendi.
//
//  Yeni eklenenler (v5→v6):
//  + kurdiLessons/{id}            — Android app ders koleksiyonu
//  + books/{bookId}               — Kullanıcı kitapları
//  + readingLists/{uid}/books/{sid} — zaten vardı, güncellenmedi
// ═══════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Yardımcı fonksiyonlar ──────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isAuth() && request.auth.token.email == 'siirgibi49@gmail.com';
    }
    function onlyChanging(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }
    function maxLen(field, n) {
      return request.resource.data[field] is string
          && request.resource.data[field].size() <= n;
    }
    function notBanned() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) == false;
    }

    // ─── USERS ────────────────────────────────────────────
    match /users/{uid} {
      allow read: if true;
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();

      // Kurdî ders tamamlama kaydı
      match /kf_progress/{doc} {
        allow read:  if isOwner(uid) || isAdmin();
        allow write: if isOwner(uid) || isAdmin();
      }
    }

    // ─── FEED ─────────────────────────────────────────────
    // Android alanları: uid, displayName, username, photoURL,
    //   text, imageURL, quoteText, authorName, bookName,
    //   likes:0, cmtCount:0, reposts:0, saves:0, ts
    match /feed/{postId} {
      allow read: if true;
      allow create: if isAuth() && notBanned()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.likes    == 0
          && request.resource.data.saves    == 0
          && request.resource.data.cmtCount == 0;
      allow update: if isAdmin()
        || (isAuth() && notBanned()
            && resource.data.uid == request.auth.uid
            && onlyChanging(['text']))
        || (isAuth() && onlyChanging(['likes']))
        || (isAuth() && onlyChanging(['saves']))
        || (isAuth() && onlyChanging(['cmtCount']))
        || (isAuth() && onlyChanging(['reposts']));
      allow delete: if (isAuth() && resource.data.uid == request.auth.uid)
          || isAdmin();

      // feed/{postId}/comments/{cmtId}
      // Android alanları: uid, displayName, photoURL, text, likes:0, ts
      // text uzunluğu: 1-500
      match /comments/{cmtId} {
        allow read: if true;
        allow create: if isAuth() && notBanned()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() >= 1
            && request.resource.data.text.size() <= 500;
        allow update: if isAuth() && onlyChanging(['likes']);
        allow delete: if (isAuth() && resource.data.uid == request.auth.uid)
            || isAdmin();
      }
    }

    // ─── FEED LIKES ───────────────────────────────────────
    // likeId = "{postId}_{uid}"
    // Android alanları: uid, postId, ts
    match /feedLikes/{likeId} {
      allow read:   if true;
      allow create: if isAuth() && notBanned()
          && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // ─── FEED SAVES ───────────────────────────────────────
    // saveId = "{postId}_{uid}"
    // Android alanları: uid, postId, ts
    match /feedSaves/{saveId} {
      allow read:   if isAuth();
      allow create: if isAuth() && notBanned()
          && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // ─── FOLLOWS ──────────────────────────────────────────
    // followId = "{fromUid}_{targetUid}"
    // Android alanları: fromUid, targetUid, ts
    match /follows/{followId} {
      allow read: if true;
      allow create: if isAuth() && notBanned()
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.fromUid != request.resource.data.targetUid;
      allow delete: if isAuth() && resource.data.fromUid == request.auth.uid;
    }

    // ─── USER BİLDİRİMLERİ ────────────────────────────────
    // userNotifs/{uid}/msgs/{notifId}
    // Android alanları: fromUid, fromName, fromPhoto, type, message, url, read, ts
    match /userNotifs/{uid} {
      allow read:  if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
      match /msgs/{notifId} {
        allow read:   if isOwner(uid) || isAdmin();
        allow create: if isAuth();
        allow update: if isOwner(uid) && onlyChanging(['read']);
        allow delete: if isOwner(uid) || isAdmin();
      }
    }

    // ─── KURDİ DERSLERİ (Android app) ────────────────────
    // kurdiLessons/{id} — orijinal kf_lessons ile aynı okuma izni
    // Android alanları: title, subtitle, type, xpReward, order
    match /kurdiLessons/{id} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ─── BOOKS ────────────────────────────────────────────
    // Android: uid, title, author, coverURL, description, genre,
    //          pageCount, language, rating, ratingCount, ts
    match /books/{bookId} {
      allow read: if true;
      allow create: if isAuth() && notBanned()
          && request.resource.data.uid == request.auth.uid;
      allow update: if (isAuth() && notBanned()
              && resource.data.uid == request.auth.uid)
          || isAdmin();
      allow delete: if (isAuth() && resource.data.uid == request.auth.uid)
          || isAdmin();
    }

    // ─── OKUMA LİSTESİ ────────────────────────────────────
    // Android status: okuyorum | okumak_istiyorum | okudum | biraktim
    match /readingLists/{uid} {
      allow read: if true;
      allow write: if false;
      match /books/{sid} {
        allow read: if true;
        allow create: if isOwner(uid)
            && request.resource.data.sid is string
            && request.resource.data.status in [
                'okuyorum','okumak_istiyorum','okudum','biraktim'
            ];
        allow update: if isOwner(uid)
            && onlyChanging(['status','updatedAt','title','coverImg','bg']);
        allow delete: if isOwner(uid) || isAdmin();
      }
    }

    // ─── BLOG YORUMLARI ───────────────────────────────────
    match /comments/{postId} {
      allow read:  if true;
      allow write: if false;
      match /msgs/{msgId} {
        allow read: if true;
        allow create: if (isAuth()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() >= 1
            && request.resource.data.text.size() <= 1000
            && request.resource.data.likes == 0)
            || (!isAuth()
            && request.resource.data.uid is string
            && request.resource.data.uid.matches('guest_[0-9]+')
            && request.resource.data.name is string
            && request.resource.data.name.size() >= 1
            && request.resource.data.name.size() <= 60
            && request.resource.data.text is string
            && request.resource.data.text.size() >= 1
            && request.resource.data.text.size() <= 1000
            && request.resource.data.likes == 0
            && request.resource.data.photoURL == '');
        allow update: if isAuth() && onlyChanging(['likes']);
        allow delete: if (isAuth() && resource.data.uid == request.auth.uid)
            || isAdmin();
      }
    }

    // ─── YORUM/BEĞENİ (eski koleksiyonlar) ───────────────
    match /commentLikes/{likeId} {
      allow read:   if isAuth();
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
    }
    match /chapterLikes/{likeId} {
      allow read:   if true;
      allow create: if isAuth() && notBanned()
          && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
    }
    match /likes/{likeId} {
      allow read:   if true;
      allow create: if isAuth() && notBanned()
          && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // ─── POSTS (eski/blog yapısı) ─────────────────────────
    match /posts/{postId} {
      allow read:   if true;
      allow create: if isAuth() && notBanned();
      allow update: if isAdmin()
          || (isAuth() && notBanned() && resource.data.uid == request.auth.uid)
          || (isAuth() && onlyChanging(['likes']));
      allow delete: if isAdmin()
          || (isAuth() && resource.data.uid == request.auth.uid);
    }

    // ─── SERİLER & BÖLÜMLER ───────────────────────────────
    match /serials/{serialId} {
      allow read: if true;
      allow create: if isAuth() && notBanned()
          && request.resource.data.uid == request.auth.uid;
      allow update, delete: if (isAuth() && resource.data.uid == request.auth.uid)
          || isAdmin();

      match /chapters/{chapterId} {
        allow read: if true;
        allow create: if isAuth() && notBanned()
            && request.resource.data.uid == request.auth.uid;
        allow update, delete: if (isAuth() && resource.data.uid == request.auth.uid)
            || isAdmin();

        match /comments/{cmtId} {
          allow read: if true;
          allow create: if isAuth() && notBanned()
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.text is string
              && request.resource.data.text.size() >= 1
              && request.resource.data.text.size() <= 500;
          allow update: if false;
          allow delete: if (isAuth() && resource.data.uid == request.auth.uid)
              || isAdmin();
        }
      }
    }

    match /serialLikes/{likeId} {
      allow read:   if true;
      allow create: if isAuth() && notBanned()
          && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // ─── KURDİ FÊRBIBE (admin içerik) ────────────────────
    match /kf_units/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /kf_lessons/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /kf_words/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /kf_vocab/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /kf_sentences/{id} { allow read: if true; allow write: if isAdmin(); }
    match /kf_exercises/{id} { allow read: if true; allow write: if isAdmin(); }
    match /kf_verbs/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /kf_grammar/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /kf_cats/{id}      { allow read: if true; allow write: if isAdmin(); }

    match /kf_reports/{reportId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAuth() && maxLen('reason', 500);
    }

    // ─── SESSIONS ─────────────────────────────────────────
    match /sessions/{sessionId} {
      allow read, delete: if isAdmin();
      allow create: if true;
      allow update: if true;
    }

    match /pendingPosts/{postId} {
      allow read:   if isAdmin()
          || (isAuth() && resource.data.authorId == request.auth.uid);
      allow create: if isAuth()
          && request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin()
          || (isAuth() && resource.data.authorId == request.auth.uid);
    }

    // ─── CONVERSATIONS (Firestore — geriye dönük) ─────────
    match /conversations/{convId} {
      allow read:   if isAuth()
          && request.auth.uid in resource.data.participants;
      allow create: if isAuth()
          && request.auth.uid in request.resource.data.participants;
      allow update: if isAuth()
          && request.auth.uid in resource.data.participants;
      allow delete: if isAdmin();

      match /msgs/{msgId} {
        allow read, write: if isAuth()
            && request.auth.uid in get(
                /databases/$(database)/documents/conversations/$(convId)
            ).data.participants;
      }
      match /typing/{uid} {
        allow read:  if isAuth();
        allow write: if isOwner(uid);
      }
    }

    // ─── CONV MESSAGES (Firestore — geriye dönük) ─────────
    match /convMessages/{convId} {
      allow read, write: if false;
      match /msgs/{msgId} {
        allow read: if isAuth()
            && request.auth.uid in get(
                /databases/$(database)/documents/conversations/$(convId)
            ).data.participants;
        allow create: if isAuth()
            && request.auth.uid in get(
                /databases/$(database)/documents/conversations/$(convId)
            ).data.participants
            && request.resource.data.senderUid == request.auth.uid;
        allow update: if isAuth()
            && request.auth.uid in get(
                /databases/$(database)/documents/conversations/$(convId)
            ).data.participants
            && onlyChanging(['seen','seenAt','seenByPhoto','seenByName',
                             'read_at','readAt','deleted','deletedAt']);
        allow delete: if isAdmin();
      }
    }

    // ─── PRESENCE & TYPING ────────────────────────────────
    match /presence/{uid} {
      allow read:   if isAuth();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid)
          && onlyChanging(['online','lastSeen','uid']);
      allow delete: if isOwner(uid) || isAdmin();
    }
    match /typing/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth()
          && request.resource.data.uid == request.auth.uid;
      allow update: if isAuth()
          && resource.data.uid == request.auth.uid;
      allow delete: if isAuth()
          && resource.data.uid == request.auth.uid;
    }

    // ─── BİLDİRİMLER (genel eski yapı) ───────────────────
    match /notifications/{notifId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && onlyChanging(['read']);
      allow delete: if isAuth() || isAdmin();
    }

  }
}
