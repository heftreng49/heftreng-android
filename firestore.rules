rules_version = '2';

// ═══════════════════════════════════════════════════════════════
//  HEFTRENG — Firestore Security Rules
//  v9 — feed list izni eklendi + visibility (friends/only_me) sistemi
//
//  Değişiklikler (v7→v8):
//  + authors: herkes okur, giriş yapmış oluşturur, takip alt kol.
//  + library_books: herkes okur, giriş yapmış oluşturur
//  + library_books/quotes: giriş yapmış ekler, sahibi siler
//  + library_books/reviews: giriş yapmış ekler, sahibi siler
// ═══════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Temel yardımcı fonksiyonlar ──────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isAuth() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function onlyChanging(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }
    function maxLen(field, n) {
      return request.resource.data[field] is string
          && request.resource.data[field].size() <= n;
    }
    function notBanned() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) == false;
    }

    // ── Gizli hesap yardımcıları ──────────────────────────────
    function isPrivateUser(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
          && get(/databases/$(database)/documents/users/$(uid)).data.get('private', false) == true;
    }
    function isFollowing(targetUid) {
      return isAuth() &&
          exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + targetUid));
    }
    function canViewContent(ownerUid) {
      return isOwner(ownerUid)
          || !isPrivateUser(ownerUid)
          || isFollowing(ownerUid)
          || isAdmin();
    }

    // ─── USERS ────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if true;
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();

      match /kf_progress/{doc} {
        allow read:  if isOwner(uid) || isAdmin();
        allow write: if isOwner(uid) || isAdmin();
      }
      match /readProgress/{doc} {
        allow read:  if isOwner(uid) || isAdmin();
        allow write: if isOwner(uid);
      }
    }

    // ─── FEED ─────────────────────────────────────────────────
    //
    //  visibility alanı:
    //   (yok / "public")  → herkese açık (varsayılan)
    //   "friends"         → sadece takipçiler + sahibi görür
    //   "only_me"         → sadece sahibi görür
    //
    function postVisible(data) {
      return data.get('visibility', 'public') == 'only_me'
          ? (isOwner(data.uid) || isAdmin())
          : data.get('visibility', 'public') == 'friends'
          ? (isOwner(data.uid) || isFollowing(data.uid) || isAdmin())
          : canViewContent(data.uid);
    }

    match /feed/{postId} {
      // Tekil belge okuma
      allow get: if postVisible(resource.data);

      // KOLEKSİYON SORGUSU (list) — whereEqualTo("type","library_quote") buradan geçer.
      // Güvenlik: her belgenin visibility alanı client-side filtrelenir;
      // rules sadece "giriş yapmış kullanıcı okuyabilir" şartını koyar.
      // Gizli gönderiler query'de gelse bile client postVisible() ile filtreler.
      allow list: if isAuth();

      allow create: if isAuth() && notBanned()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.likes == 0
          && request.resource.data.saves == 0
          && request.resource.data.cmtCount == 0;
      allow update: if isAdmin()
        || (isAuth() && notBanned() && resource.data.uid == request.auth.uid && onlyChanging(['text']))
        || (isAuth() && onlyChanging(['likes']))
        || (isAuth() && onlyChanging(['saves']))
        || (isAuth() && onlyChanging(['cmtCount']))
        || (isAuth() && onlyChanging(['repostsCount']))
        || (isAdmin() && onlyChanging(['visibility']));
      allow delete: if (isAuth() && resource.data.uid == request.auth.uid) || isAdmin();

      match /comments/{cmtId} {
        allow read: if canViewContent(get(/databases/$(database)/documents/feed/$(postId)).data.uid);
        allow create: if isAuth() && notBanned()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() >= 1
            && request.resource.data.text.size() <= 500;
        allow update: if isAuth() && onlyChanging(['likes']);
        allow delete: if (isAuth() && resource.data.uid == request.auth.uid) || isAdmin();
      }
    }

    // ─── BLOG YORUMLARI ───────────────────────────────────────
    match /comments/{postId} {
      allow read:  if true;
      allow write: if false;
      match /msgs/{msgId} {
        allow read: if true;
        allow create: if isAuth() && notBanned()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() >= 1
            && request.resource.data.text.size() <= 1000
            && request.resource.data.likes == 0;
        allow update: if isAuth() && onlyChanging(['likes']);
        allow delete: if (isAuth() && resource.data.uid == request.auth.uid) || isAdmin();
      }
    }

    // ─── LIKES & SAVES ────────────────────────────────────────
    match /commentLikes/{likeId} {
      allow read:   if isAuth();
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
    }
    match /chapterLikes/{likeId} {
      allow read:   if isAuth();
      allow create: if isAuth() && notBanned()
          && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
    }
    match /feedLikes/{likeId} {
      allow read:   if isAuth();
      allow create: if isAuth() && notBanned() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
    }
    match /feedSaves/{saveId} {
      allow read:   if isAuth();
      allow create: if isAuth() && notBanned() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
    }
    match /likes/{likeId} {
      allow read:   if isAuth();
      allow create: if isAuth() && notBanned() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // ─── FOLLOWS ──────────────────────────────────────────────
    match /follows/{followId} {
      allow read: if true;
      allow create: if isAuth() && notBanned()
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.fromUid != request.resource.data.targetUid;
      allow delete: if isAuth() && resource.data.fromUid == request.auth.uid;
    }

    // ─── POSTS ────────────────────────────────────────────────
    match /posts/{postId} {
      allow read:   if canViewContent(resource.data.uid);
      allow create: if isAuth() && notBanned()
          && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin()
          || (isAuth() && notBanned() && resource.data.uid == request.auth.uid)
          || (isAuth() && onlyChanging(['likes']));
      allow delete: if isAdmin()
          || (isAuth() && resource.data.uid == request.auth.uid);
    }

    // ─── SERIALS & CHAPTERS ───────────────────────────────────
    match /serials/{serialId} {
      allow read: if canViewContent(resource.data.uid);
      allow create: if isAuth() && notBanned()
          && request.resource.data.uid == request.auth.uid;
      allow update, delete: if (isAuth() && resource.data.uid == request.auth.uid) || isAdmin();

      match /chapters/{chapterId} {
        allow read: if canViewContent(get(/databases/$(database)/documents/serials/$(serialId)).data.uid);
        allow create: if isAuth() && notBanned()
            && request.resource.data.uid == request.auth.uid;
        allow update: if (isAuth() && resource.data.uid == request.auth.uid) || isAdmin()
            || (isAuth() && onlyChanging(['likes']))
            || (isAuth() && onlyChanging(['cmtCount']));
        allow delete: if (isAuth() && resource.data.uid == request.auth.uid) || isAdmin();

        match /comments/{cmtId} {
          allow read: if canViewContent(get(/databases/$(database)/documents/serials/$(serialId)).data.uid);
          allow create: if isAuth() && notBanned()
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.text is string
              && request.resource.data.text.size() >= 1
              && request.resource.data.text.size() <= 1000;
          allow update:
              if (isAuth() && resource.data.uid == request.auth.uid
                  && onlyChanging(['text', 'edited']))
              || (isAuth() && onlyChanging(['likes']));
          allow delete: if (isAuth() && resource.data.uid == request.auth.uid) || isAdmin();
        }
      }
    }

    // ─── KİTAPLAR (kullanıcı kitapları) ──────────────────────
    match /books/{bookId} {
      allow read: if canViewContent(resource.data.uid);
      allow create: if isAuth() && notBanned()
          && request.resource.data.uid == request.auth.uid;
      allow update: if (isAuth() && notBanned() && resource.data.uid == request.auth.uid)
          || isAdmin();
      allow delete: if (isAuth() && resource.data.uid == request.auth.uid)
          || isAdmin();

      match /chapters/{chapterId} {
        allow read: if canViewContent(get(/databases/$(database)/documents/books/$(bookId)).data.uid);
        allow create: if isAuth() && notBanned()
            && request.resource.data.uid == request.auth.uid;
        allow update, delete: if (isAuth() && resource.data.uid == request.auth.uid) || isAdmin();
      }
    }

    // ─── SERİ BEĞENİLERİ ──────────────────────────────────────
    match /serialLikes/{likeId} {
      allow read:   if isAuth();
      allow create: if isAuth() && notBanned()
          && request.resource.data.uid == request.auth.uid;
      allow update: if isAuth() && resource.data.uid == request.auth.uid;
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // ─── NOTIFICATIONS ────────────────────────────────────────
    match /notifications/{notifId} {
      allow read:   if isAuth() && (resource.data.toUid == request.auth.uid || isAdmin());
      allow create: if isAuth() && notBanned()
          && request.resource.data.fromUid == request.auth.uid;
      allow update: if isAuth() && resource.data.toUid == request.auth.uid
          && onlyChanging(['read']);
      allow delete: if isAuth() && resource.data.toUid == request.auth.uid || isAdmin();
    }
    match /userNotifs/{uid} {
      allow read:  if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
      match /msgs/{notifId} {
        allow read:   if isOwner(uid) || isAdmin();
        allow create: if isAuth() && notBanned();
        allow update: if isOwner(uid) && onlyChanging(['read']);
        allow delete: if isOwner(uid) || isAdmin();
      }
    }

    // ─── SESSIONS ─────────────────────────────────────────────
    match /sessions/{sessionId} {
      allow read, delete: if isAdmin();
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.uid == request.auth.uid;
    }

    match /pendingPosts/{postId} {
      allow read:   if isAdmin() || (isAuth() && resource.data.authorId == request.auth.uid);
      allow create: if isAuth() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isAuth() && resource.data.authorId == request.auth.uid);
    }

    // ─── CONVERSATIONS ────────────────────────────────────────
    match /conversations/{convId} {
      allow read:   if isAuth() && request.auth.uid in resource.data.participants;
      allow create: if isAuth()
          && request.auth.uid in request.resource.data.participants;
      allow update: if isAuth() && request.auth.uid in resource.data.participants;
      allow delete: if isAdmin();

      match /msgs/{msgId} {
        allow read, write: if isAuth()
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
      }
      match /typing/{uid} {
        allow read:  if isAuth();
        allow write: if isOwner(uid);
      }
    }

    match /convMessages/{convId} {
      allow read, write: if false;
      match /msgs/{msgId} {
        allow read: if isAuth()
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow create: if isAuth()
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants
            && request.resource.data.senderUid == request.auth.uid;
        allow update: if isAuth()
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants
            && onlyChanging(['seen', 'seenAt', 'seenByPhoto', 'seenByName',
                             'read_at', 'readAt', 'deleted', 'deletedAt',
                             'read', 'liked_by', 'edited', 'text']);
        allow delete: if isAdmin();
      }
    }

    // ─── PRESENCE & TYPING ────────────────────────────────────
    match /presence/{uid} {
      allow read:   if isAuth();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid)
          && onlyChanging(['online', 'lastSeen', 'uid', 'appVersion', 'platform']);
      allow delete: if isOwner(uid) || isAdmin();
    }
    match /typing/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth()
          && request.resource.data.uid == request.auth.uid;
      allow update: if isAuth()
          && resource.data.uid == request.auth.uid;
      allow delete: if isAuth()
          && resource.data.uid == request.auth.uid;
    }

    // ─── OKUMA LİSTESİ ────────────────────────────────────────
    match /readingLists/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
      match /books/{sid} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid)
            && request.resource.data.sid is string
            && request.resource.data.status in ['okuyorum','okumak_istiyorum','okudum','biraktim'];
        allow update: if isOwner(uid)
            && onlyChanging(['status', 'updatedAt', 'title', 'coverImg', 'bg']);
        allow delete: if isOwner(uid) || isAdmin();
      }
    }

    // ─── KURDİ FÊRBIBE ────────────────────────────────────────
    match /kf_units/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /kf_lessons/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /kf_words/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /kf_vocab/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /kf_sentences/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /kf_exercises/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /kf_verbs/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /kf_grammar/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /kf_cats/{id}       { allow read: if true; allow write: if isAdmin(); }

    // ─── USERNAMES ────────────────────────────────────────────
    match /usernames/{handle} {
      allow read: if true;
      allow create: if isAuth()
          && request.resource.data.uid == request.auth.uid;
      allow update: if isAuth()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuth()
          && resource.data.uid == request.auth.uid;
    }

    // ─── CMS ──────────────────────────────────────────────────
    match /cms/{docId}               { allow read: if isAuth(); allow write: if isAdmin(); }
    match /cms_pages/{docId}         { allow read: if true;     allow write: if isAdmin(); }
    match /cms_banners/{docId}       { allow read: if true;     allow write: if isAdmin(); }
    match /cms_announcements/{docId} { allow read: if true;     allow write: if isAdmin(); }
    match /cms_categories/{docId}    { allow read: if true;     allow write: if isAdmin(); }
    match /cms_ads/{docId}           { allow read: if isAuth(); allow write: if isAdmin(); }

    // ─── APP CONFIG ───────────────────────────────────────────
    match /appConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── RAPORLAR ─────────────────────────────────────────────
    match /kf_reports/{reportId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAuth() && maxLen('reason', 500);
    }

    // ══════════════════════════════════════════════════════════
    //  YENİ v8 — YAZAR / KİTAP KÜTÜPHANESİ
    // ══════════════════════════════════════════════════════════

    // ─── AUTHORS ──────────────────────────────────────────────
    match /authors/{authorId} {
      // Herkes okuyabilir
      allow read: if true;
      // Yeni yazar oluşturma: giriş yapmış herkes (ilerleyen sürümde isAdmin() yapılabilir)
      allow create: if isAuth() && notBanned();
      // Güncelleme: sadece sayaç alanları veya admin
      allow update: if isAdmin()
          || (isAuth() && onlyChanging(['bookCount', 'quoteCount', 'reviewCount', 'followerCount']));
      allow delete: if isAdmin();

      // Yazar takip koleksiyonu
      match /follows/{uid} {
        allow read:   if true;
        allow create: if isOwner(uid) && notBanned();
        allow delete: if isOwner(uid);
      }
    }

    // ─── LIBRARY BOOKS ────────────────────────────────────────
    match /library_books/{bookId} {
      // Herkes okuyabilir
      allow read: if true;
      // Oluşturma: giriş yapmış herkes (ilerleyen sürümde kısıtlanabilir)
      allow create: if isAuth() && notBanned();
      // Güncelleme: sayaçlar ve puan alanları veya admin
      allow update: if isAdmin()
          || (isAuth() && onlyChanging(['quoteCount', 'reviewCount', 'avgRating']));
      allow delete: if isAdmin();

      // ── Alıntılar ──────────────────────────────────────────
      match /quotes/{quoteId} {
        allow read: if true;
        allow create: if isAuth() && notBanned()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() >= 1
            && request.resource.data.text.size() <= 2000;
        // Sahibi feedPostId güncelleyebilir veya silebilir
        allow update: if isAuth()
            && resource.data.uid == request.auth.uid
            && onlyChanging(['feedPostId', 'likesCount']);
        allow delete: if (isAuth() && resource.data.uid == request.auth.uid) || isAdmin();
      }

      // ── İncelemeler ────────────────────────────────────────
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuth() && notBanned()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() >= 1
            && request.resource.data.text.size() <= 3000
            && request.resource.data.rating is number
            && request.resource.data.rating >= 1
            && request.resource.data.rating <= 5;
        allow update: if isAuth()
            && resource.data.uid == request.auth.uid
            && onlyChanging(['feedPostId', 'text', 'rating']);
        allow delete: if (isAuth() && resource.data.uid == request.auth.uid) || isAdmin();
      }
    }

  }
}

    // ── Kullanım koşulları kabul audit trail ─────────────────────────────
    // Kullanıcı kendi kaydını yazabilir, okuyamaz, silemez, değiştiremez.
    // Sadece admin (server-side) okuyabilir.
    match /terms_acceptances/{docId} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if false;  // sadece Firebase Admin SDK
    }

}