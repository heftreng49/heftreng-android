rules_version = '2';

// ═══════════════════════════════════════════════════════════════
//  HEFTRENG — Firestore Security Rules  v11 (Güvenli Sürüm)
// ═══════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Temel yardımcılar ─────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    function onlyChanging(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }
    function maxLen(field, n) {
      return request.resource.data[field] is string
          && request.resource.data[field].size() <= n;
    }
    function notBanned() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) == false;
    }

    // ── Rol fonksiyonları ──────────────────────────────────────
    function getRole() {
      return isAuth() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        ? get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', 'none')
        : 'none';
    }
    function isAdmin() {
      return getRole() == 'admin';
    }
    function isModerator() {
      return getRole() in ['admin', 'moderator'];
    }
    function isEditor() {
      return getRole() in ['admin', 'editor'];
    }
    function isLibrarian() {
      return getRole() in ['admin', 'kutuphaneci'];
    }
    function isStaff() {
      return getRole() in ['admin', 'moderator', 'editor', 'kutuphaneci'];
    }

    // ── İzin tabanlı kontrol ───────────────────────────────────
    function hasPermission(perm) {
      return isAuth()
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          && perm in get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('permissions', []);
    }

    // ── Gizli hesap yardımcıları ──────────────────────────────
    function isPrivateUser(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
          && get(/databases/$(database)/documents/users/$(uid)).data.get('private', false) == true;
    }
    function isFollowing(targetUid) {
      return isAuth() &&
          exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + targetUid));
    }
    function canViewContent(ownerUid) {
      return isOwner(ownerUid)
          || !isPrivateUser(ownerUid)
          || isFollowing(ownerUid)
          || isStaff();
    }

    // ─── ADMINS (yardımcı yönetimi) ───────────────────────────
    match /admins/{uid} {
      allow read:   if isAuth();
      allow create: if isAuth() && (isAdmin() || request.auth.uid == uid);
      allow update: if isAdmin();
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    // ─── USERS ────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if true;
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isModerator();
      allow delete: if isOwner(uid) || isAdmin();

      match /kf_progress/{doc} {
        allow read:  if isOwner(uid) || isAdmin();
        allow write: if isOwner(uid) || isAdmin();
      }
      match /readProgress/{doc} {
        allow read:  if isOwner(uid) || isAdmin();
        allow write: if isOwner(uid);
      }
    }

    // ─── FEED ─────────────────────────────────────────────────
    function postVisible(data) {
      return data.get('visibility', 'public') == 'only_me'
          ? (isOwner(data.uid) || isStaff())
          : data.get('visibility', 'public') == 'friends'
          ? (isOwner(data.uid) || isFollowing(data.uid) || isStaff())
          : canViewContent(data.uid);
    }

    match /feed/{postId} {
      allow get:  if postVisible(resource.data);
      // GÜVENLİK GÜNCELLEMESİ: Botların giriş yapmadan tüm veri tabanını listelemesini engellemek için limit zorunluluğu
      allow list: if true && request.query.limit <= 25; 

      allow create: if isAuth() && notBanned()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.likes == 0
          && request.resource.data.saves == 0
          && request.resource.data.cmtCount == 0;

      allow update:
          if isAdmin()
          || (isAuth() && notBanned() && resource.data.uid == request.auth.uid && onlyChanging(['text']))
          // GÜVENLİK GÜNCELLEMESİ: Sayaçların botlar tarafından tek istekte manipüle edilmesini (+1/-1 harici değer yazılmasını) engelleme
          || (isAuth() && onlyChanging(['likes']) && (request.resource.data.likes == resource.data.likes + 1 || request.resource.data.likes == resource.data.likes - 1))
          || (isAuth() && onlyChanging(['saves']) && (request.resource.data.saves == resource.data.saves + 1 || request.resource.data.saves == resource.data.saves - 1))
          || (isAuth() && onlyChanging(['cmtCount']) && (request.resource.data.cmtCount == resource.data.cmtCount + 1 || request.resource.data.cmtCount == resource.data.cmtCount - 1))
          || (isAuth() && onlyChanging(['repostsCount']) && (request.resource.data.repostsCount == resource.data.repostsCount + 1 || request.resource.data.repostsCount == resource.data.repostsCount - 1))
          || ((isModerator() || hasPermission("edit")) && onlyChanging(['moderationStatus','moderationReason','moderationNote','moderatedBy','moderatedAt']));

      allow delete: if (isAuth() && resource.data.uid == request.auth.uid) || isModerator() || hasPermission("edit");

      match /comments/{cmtId} {
        allow read: if canViewContent(get(/databases/$(database)/documents/feed/$(postId)).data.uid);
        allow create: if isAuth() && notBanned()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() >= 1
            && request.resource.data.text.size() <= 500;
        allow update: if isAuth() && onlyChanging(['likes']) && (request.resource.data.likes == resource.data.likes + 1 || request.resource.data.likes == resource.data.likes - 1);
        allow delete: if (isAuth() && resource.data.uid == request.auth.uid) || isModerator() || hasPermission("edit");
      }
    }

    // ─── BLOG YORUMLARI ───────────────────────────────────────
    match /comments/{postId} {
      allow read:  if true && request.query.limit <= 30;
      allow write: if false;
      match /msgs/{msgId} {
        allow read: if true;
        allow create: if isAuth() && notBanned()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() >= 1
            && request.resource.data.text.size() <= 1000
            && request.resource.data.likes == 0;
        allow update: if isAuth() && onlyChanging(['likes']) && (request.resource.data.likes == resource.data.likes + 1 || request.resource.data.likes == resource.data.likes - 1);
        allow delete: if (isAuth() && resource.data.uid == request.auth.uid) || isModerator() || hasPermission("edit");
      }
    }

    // ─── LIKES & SAVES ────────────────────────────────────────
    match /commentLikes/{likeId} {
      allow read:   if isAuth();
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
    }
    match /chapterLikes/{likeId} {
      allow read:   if isAuth();
      allow create: if isAuth() && notBanned() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
    }
    match /feedLikes/{likeId} {
      allow read:   if isAuth();
      allow create: if isAuth() && notBanned() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
    }
    match /feedSaves/{saveId} {
      allow read:   if isAuth();
      allow create: if isAuth() && notBanned() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
    }
    match /likes/{likeId} {
      allow read:   if isAuth();
      allow create: if isAuth() && notBanned() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // ─── FOLLOWS ──────────────────────────────────────────────
    match /follows/{followId} {
      allow read: if true && request.query.limit <= 50;
      allow create: if isAuth() && notBanned()
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.fromUid != request.resource.data.targetUid;
      allow delete: if isAuth() && resource.data.fromUid == request.auth.uid;
    }

    // ─── POSTS ────────────────────────────────────────────────
    match /posts/{postId} {
      allow read:   if canViewContent(resource.data.uid);
      allow create: if isAuth() && notBanned() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin()
          || (isAuth() && notBanned() && resource.data.uid == request.auth.uid)
          || (isAuth() && onlyChanging(['likes']) && (request.resource.data.likes == resource.data.likes + 1 || request.resource.data.likes == resource.data.likes - 1));
      allow delete: if (isAuth() && resource.data.uid == request.auth.uid) || isModerator() || hasPermission("edit");
    }

    // ─── SERIALS & CHAPTERS ───────────────────────────────────
    match /serials/{serialId} {
      allow read: if canViewContent(resource.data.uid);
      allow create: if isAuth() && notBanned() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if (isAuth() && resource.data.uid == request.auth.uid) || isModerator();

      match /chapters/{chapterId} {
        allow read: if canViewContent(get(/databases/$(database)/documents/serials/$(serialId)).data.uid);
        allow create: if isAuth() && notBanned() && request.resource.data.uid == request.auth.uid;
        allow update: if (isAuth() && resource.data.uid == request.auth.uid) || isModerator()
            || (isAuth() && onlyChanging(['likes']) && (request.resource.data.likes == resource.data.likes + 1 || request.resource.data.likes == resource.data.likes - 1))
            || (isAuth() && onlyChanging(['cmtCount']) && (request.resource.data.cmtCount == resource.data.cmtCount + 1 || request.resource.data.cmtCount == resource.data.cmtCount - 1));
        allow delete: if (isAuth() && resource.data.uid == request.auth.uid) || isModerator() || hasPermission("edit");

        match /comments/{cmtId} {
          allow read: if canViewContent(get(/databases/$(database)/documents/serials/$(serialId)).data.uid);
          allow create: if isAuth() && notBanned()
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.text is string
              && request.resource.data.text.size() >= 1
              && request.resource.data.text.size() <= 1000;
          allow update:
              if (isAuth() && resource.data.uid == request.auth.uid && onlyChanging(['text','edited']))
              || (isAuth() && onlyChanging(['likes']) && (request.resource.data.likes == resource.data.likes + 1 || request.resource.data.likes == resource.data.likes - 1));
          allow delete: if (isAuth() && resource.data.uid == request.auth.uid) || isModerator() || hasPermission("edit");
        }
      }
    }

    // ─── KİTAPLAR (kullanıcı kitapları) ──────────────────────
    match /books/{bookId} {
      allow read: if canViewContent(resource.data.uid);
      allow create: if isAuth() && notBanned() && request.resource.data.uid == request.auth.uid;
      allow update: if (isAuth() && notBanned() && resource.data.uid == request.auth.uid) || isModerator();
      allow delete: if (isAuth() && resource.data.uid == request.auth.uid) || isModerator() || hasPermission("edit");

      match /chapters/{chapterId} {
        allow read: if canViewContent(get(/databases/$(database)/documents/books/$(bookId)).data.uid);
        allow create: if isAuth() && notBanned() && request.resource.data.uid == request.auth.uid;
        allow update, delete: if (isAuth() && resource.data.uid == request.auth.uid) || isModerator();
      }
    }

    // ─── SERİ BEĞENİLERİ ──────────────────────────────────────
    match /serialLikes/{likeId} {
      allow read:   if isAuth();
      allow create: if isAuth() && notBanned() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuth() && resource.data.uid == request.auth.uid;
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // ─── NOTIFICATIONS ────────────────────────────────────────
    match /notifications/{notifId} {
      allow read:   if isAuth() && (resource.data.toUid == request.auth.uid || isAdmin());
      allow create: if isAuth() && notBanned() && request.resource.data.fromUid == request.auth.uid;
      allow update: if isAuth() && resource.data.toUid == request.auth.uid && onlyChanging(['read']);
      allow delete: if (isAuth() && resource.data.toUid == request.auth.uid) || isAdmin();
    }
    match /userNotifs/{uid} {
      allow read:  if isOwner(uid) || isStaff();
      allow write: if isStaff();
      match /msgs/{notifId} {
        allow read:   if isOwner(uid) || isStaff();
        allow create: if isAuth() && notBanned();
        allow update: if isOwner(uid) && onlyChanging(['read']);
        allow delete: if isOwner(uid) || isAdmin();
      }
    }

    // ─── SESSIONS ─────────────────────────────────────────────
    match /sessions/{sessionId} {
      allow read, delete: if isAdmin();
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // ─── BEKLEYEN GÖNDERİLER ──────────────────────────────────
    match /pendingPosts/{postId} {
      allow read:   if isModerator() || isEditor() || hasPermission("pending") || (isAuth() && resource.data.authorId == request.auth.uid);
      allow create: if isAuth() && request.resource.data.authorId == request.auth.uid;
      allow update: if isModerator() || isEditor() || hasPermission("pending");
      allow delete: if isModerator() || isEditor() || hasPermission("pending") || (isAuth() && resource.data.authorId == request.auth.uid);
    }

    // ─── ŞİKAYETLER ───────────────────────────────────────────
    match /reports/{reportId} {
      allow read, update: if isModerator() || hasPermission("reports");
      allow delete:       if isAdmin() || hasPermission("staff");
      allow create:       if isAuth() && maxLen('reason', 500);
    }

    // ─── İTİRAZLAR ────────────────────────────────────────────
    match /appeals/{appealId} {
      allow read, update: if isModerator() || hasPermission("appeals");
      allow delete:       if isAdmin() || hasPermission("staff");
      allow create:       if isAuth();
    }

    // ─── CONVERSATIONS (SOHBETLER) ────────────────────────────
    match /conversations/{convId} {
      allow read:   if isAuth() && request.auth.uid in resource.data.participants;
      allow create: if isAuth() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuth() && request.auth.uid in resource.data.participants;
      allow delete: if isAdmin();

      match /msgs/{msgId} {
        // GÜVENLİK GÜNCELLEMESİ: read ve list ayrıldı, döküman manipülasyonu ve yetkisiz text değişimi engellendi.
        allow read: if isAuth() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow create: if isAuth() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants && request.resource.data.uid == request.auth.uid;
        allow update: if isAuth() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants && onlyChanging(['likes']);
        allow delete: if (isAuth() && resource.data.uid == request.auth.uid) || isModerator() || hasPermission("edit");
      }
      match /typing/{uid} {
        allow read:  if isAuth();
        allow write: if isOwner(uid);
      }
    }

    match /convMessages/{convId} {
      allow read, write: if false;
      match /msgs/{msgId} {
        allow read: if isAuth() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow create: if isAuth() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants && request.resource.data.senderUid == request.auth.uid;
        allow update: if isAuth() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants
            && onlyChanging(['seen','seenAt','seenByPhoto','seenByName','read_at','readAt','deleted','deletedAt','read','liked_by','edited','text']);
        allow delete: if isAdmin();
      }
    }

    // ─── PRESENCE & TYPING ────────────────────────────────────
    match /presence/{uid} {
      allow read:   if isAuth();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) && onlyChanging(['online','lastSeen','uid','appVersion','platform']);
      allow delete: if isOwner(uid) || isAdmin();
    }
    match /typing/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuth() && resource.data.uid == request.auth.uid;
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // ─── OKUMA LİSTESİ ────────────────────────────────────────
    match /readingLists/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
      match /books/{sid} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) && request.resource.data.sid is string && request.resource.data.status in ['okuyorum','okumak_istiyorum','okudum','biraktim'];
        allow update: if isOwner(uid) && onlyChanging(['status','updatedAt','title','coverImg','bg']);
        allow delete: if isOwner(uid) || isAdmin();
      }
    }

    // ─── KURDİ FÊRBIBE ────────────────────────────────────────
    match /kf_units/{id}      { allow read: if true; allow write: if isAdmin() || hasPermission("kurdi"); }
    match /kf_lessons/{id}    { allow read: if true; allow write: if isAdmin() || hasPermission("kurdi"); }
    match /kf_words/{id}      { allow read: if true; allow write: if isAdmin() || hasPermission("kurdi"); }
    match /kf_vocab/{id}      { allow read: if true; allow write: if isAdmin() || hasPermission("kurdi"); }
    match /kf_sentences/{id}  { allow read: if true; allow write: if isAdmin() || hasPermission("kurdi"); }
    match /kf_exercises/{id}  { allow read: if true; allow write: if isAdmin() || hasPermission("kurdi"); }
    match /kf_verbs/{id}      { allow read: if true; allow write: if isAdmin() || hasPermission("kurdi"); }
    match /kf_grammar/{id}    { allow read: if true; allow write: if isAdmin() || hasPermission("kurdi"); }
    match /kf_cats/{id}       { allow read: if true; allow write: if isAdmin() || hasPermission("kurdi"); }
    match /kf_reports/{reportId} {
      allow read, update: if isModerator();
      allow delete:       if isAdmin();
      allow create:       if isAuth() && maxLen('reason', 500);
    }

    // ─── USERNAMES ────────────────────────────────────────────
    match /usernames/{handle} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuth() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // ─── CMS ──────────────────────────────────────────────────
    match /cms/{docId}               { allow read: if isAuth();  allow write: if isEditor() || hasPermission("edit"); }
    match /cms_pages/{docId}         { allow read: if true;      allow write: if isEditor() || hasPermission("edit"); }
    match /cms_banners/{docId}       { allow read: if true;      allow write: if isEditor() || hasPermission("edit"); }
    match /cms_announcements/{docId} { allow read: if true;      allow write: if isEditor() || hasPermission("edit"); }
    match /cms_categories/{docId}    { allow read: if true;      allow write: if isEditor() || hasPermission("edit"); }
    match /cms_ads/{docId}           { allow read: if isAuth();  allow write: if isEditor() || hasPermission("edit"); }

    // ─── APP CONFIG ───────────────────────────────────────────
    match /appConfig/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ─── YAZAR / KİTAP KÜTÜPHANESİ ──────────────────────────
    match /authors/{authorId} {
      allow read: if true;
      allow create: if isLibrarian() || hasPermission("library");
      allow update: if isLibrarian() || (isAuth() && onlyChanging(['bookCount','quoteCount','reviewCount','followerCount']));
      allow delete: if isLibrarian() || hasPermission("library");

      match /follows/{uid} {
        allow read:   if true;
        allow create: if isOwner(uid) && notBanned();
        allow delete: if isOwner(uid);
      }
    }

    match /library_books/{bookId} {
      allow read: if true;
      allow create: if isLibrarian() || hasPermission("library") || (isAuth() && notBanned());
      allow update: if isLibrarian() || hasPermission("library") || (isAuth() && onlyChanging(['quoteCount','reviewCount','avgRating']));
      allow delete: if isLibrarian() || hasPermission("library");

      match /quotes/{quoteId} {
        allow read: if true;
        allow create: if isAuth() && notBanned() && request.resource.data.uid == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 2000;
        allow update: if isAuth() && resource.data.uid == request.auth.uid && onlyChanging(['feedPostId','likesCount']);
        allow delete: if (isAuth() && resource.data.uid == request.auth.uid) || isLibrarian();
      }

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuth() && notBanned() && request.resource.data.uid == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 3000 && request.resource.data.rating is number && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
        allow update: if isAuth() && resource.data.uid == request.auth.uid && onlyChanging(['feedPostId','text','rating']);
        allow delete: if (isAuth() && resource.data.uid == request.auth.uid) || isLibrarian();
      }
    }

  }
}
