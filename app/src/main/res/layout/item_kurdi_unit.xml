<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:padding="16dp"
    android:background="@color/surface" android:layout_marginBottom="2dp"
    android:gravity="center_vertical">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tvUnitTitle" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="@color/text_primary"
            android:textSize="16sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tvUnitLevel" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="@color/text_secondary"
            android:textSize="13sp" android:layout_marginTop="2dp"/>
    </LinearLayout>
    <TextView android:id="@+id/tvUnitXP" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textColor="@color/brand_primary"
        android:textSize="14sp" android:textStyle="bold"/>
    <ImageView android:layout_width="24dp" android:layout_height="24dp"
        android:src="@drawable/ic_arrow_back" android:rotation="180"
        android:layout_marginStart="8dp"/>
</LinearLayout>
