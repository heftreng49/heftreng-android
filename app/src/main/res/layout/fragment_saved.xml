<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background">

    <HorizontalScrollView android:layout_width="match_parent"
        android:layout_height="wrap_content" android:background="@color/surface"
        android:scrollbars="none">
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupSaved" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:padding="8dp"/>
    </HorizontalScrollView>

    <TextView android:id="@+id/tvEmpty" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Kayıtlı içerik yok"
        android:textColor="@color/text_secondary" android:textSize="16sp"
        android:gravity="center" android:padding="32dp" android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSaved" android:layout_width="match_parent"
        android:layout_height="match_parent" android:clipToPadding="false"
        android:paddingBottom="88dp"/>
</LinearLayout>
