<?xml version="1.0" encoding="utf-8"?>
<!-- Feed PostCard ile aynı görünüm: rounded 16dp, border, iç padding 14dp -->
<com.google.android.gms.ads.nativead.NativeAdView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/native_ad_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="5dp"
    android:background="@drawable/bg_native_ad_card"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Üst satır: "Reklam" etiketi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <!-- Reklam rozeti -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reklam"
                android:textSize="9sp"
                android:textColor="#9B72F5"
                android:background="@drawable/bg_ad_badge"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <!-- Sponsor ikonu -->
            <ImageView
                android:id="@+id/ad_app_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_ad_icon"/>

        </LinearLayout>

        <!-- Başlık -->
        <TextView
            android:id="@+id/ad_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#F2EEFF"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="6dp"/>

        <!-- Açıklama -->
        <TextView
            android:id="@+id/ad_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#9181B8"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="12dp"/>

        <!-- MediaView: video reklamlarda görünür, görsel yoksa gizlenir -->
        <com.google.android.gms.ads.nativead.MediaView
            android:id="@+id/ad_media"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:visibility="gone"
            android:layout_marginBottom="12dp"/>

        <!-- Alt satır: CTA butonu -->
        <Button
            android:id="@+id/ad_call_to_action"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#8B5CF6"
            android:stateListAnimator="@null"/>

    </LinearLayout>

</com.google.android.gms.ads.nativead.NativeAdView>
