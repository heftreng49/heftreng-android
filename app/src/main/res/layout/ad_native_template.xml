<?xml version="1.0" encoding="utf-8"?>
<!--
    ad_native_template.xml — Native reklam şablonu

    Boyutlandırma:
    • MediaView: 0dp/0dp + varsayılan W,16:9 ratio
    • Gerçek ratio kod tarafında (updateMediaSize) ConstraintSet ile güncellenir
    • Yatay reklamlar: MATCH_CONSTRAINT + ratio → tam genişlik, doğru yükseklik
    • Dikey reklamlar: sabit px + centerHorizontally → siyah kenar yok

    Yapı (flat ConstraintLayout — tek ölçüm geçişi):
    NativeAdView
      └─ ConstraintLayout
           ├─ ImageView      (ikon)
           ├─ TextView       (başlık)
           ├─ TextView       (reklamcı)
           ├─ RatingBar      (yıldız)
           ├─ TextView       (sponsorlu)
           ├─ TextView       (açıklama)
           ├─ MediaView      (video/görsel)
           ├─ Barrier        (MediaView altı)
           └─ Button         (CTA)
-->
<com.google.android.gms.ads.nativead.NativeAdView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_native_ad_card"
    android:padding="12dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- İkon -->
        <ImageView
            android:id="@+id/ad_app_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_ad_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Başlık -->
        <TextView
            android:id="@+id/ad_headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/ad_headline_color"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintTop_toTopOf="@id/ad_app_icon"
            app:layout_constraintStart_toEndOf="@id/ad_app_icon"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Reklamcı adı -->
        <TextView
            android:id="@+id/ad_advertiser"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone"
            android:layout_marginStart="8dp"
            android:layout_marginTop="1dp"
            app:layout_constraintTop_toBottomOf="@id/ad_headline"
            app:layout_constraintStart_toEndOf="@id/ad_app_icon"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Yıldız değerlendirmesi -->
        <RatingBar
            android:id="@+id/ad_stars"
            style="?android:attr/ratingBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:isIndicator="true"
            android:numStars="5"
            android:stepSize="0.5"
            android:visibility="gone"
            android:layout_marginStart="8dp"
            android:layout_marginTop="1dp"
            app:layout_constraintTop_toBottomOf="@id/ad_advertiser"
            app:layout_constraintStart_toEndOf="@id/ad_app_icon"/>

        <!-- Sponsorlu etiketi -->
        <TextView
            android:id="@+id/ad_sponsored_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sponsorlu"
            android:textSize="8sp"
            android:textColor="@color/ad_badge_text"
            android:background="@drawable/bg_ad_badge"
            android:paddingHorizontal="4dp"
            android:paddingVertical="1dp"
            android:layout_marginTop="2dp"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toBottomOf="@id/ad_stars"
            app:layout_constraintStart_toEndOf="@id/ad_app_icon"/>

        <!-- Açıklama metni -->
        <TextView
            android:id="@+id/ad_body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/ad_body_color"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/ad_app_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!--
            MediaView:
            • 0dp/0dp: ConstraintSet tam kontrol
            • Varsayılan W,16:9: kod ratio gelene kadar boşluk bırakmaz
            • Gerçek ratio: updateMediaSize() ile güncellenir
        -->
        <com.google.android.gms.ads.nativead.MediaView
            android:id="@+id/ad_media"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:clipToOutline="true"
            app:layout_constraintTop_toBottomOf="@id/ad_body"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintDimensionRatio="W,16:9"/>

        <!--
            Barrier: MediaView GONE olduğunda buton ad_body'ye yapışır,
            VISIBLE olduğunda MediaView altına geçer — constraint değişikliği gerekmez.
        -->
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/ad_media_barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="ad_media"/>

        <!-- CTA butonu -->
        <Button
            android:id="@+id/ad_call_to_action"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="@color/ad_cta_bg"
            android:stateListAnimator="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/ad_media_barrier"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.gms.ads.nativead.NativeAdView>
