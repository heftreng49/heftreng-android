<?xml version="1.0" encoding="utf-8"?>
<!--
    ad_native_template.xml — TEK native ad şablonu.

    ESKİ DURUM:
      ad_small_template.xml  ─┐
      ad_medium_template.xml  ├─ İÇERİK BİREBİR AYNI. Tek fark: ad_media height değeri.
      ad_large_template.xml  ─┘

    NEDEN 3 DOSYA SORUNLUYDU?
    • Kod tabanı şişiyor, senkronizasyon zorlaşıyor (3 yerde aynı değişiklik)
    • Build süresi artıyor (3 layout inflate edilip ölçülüyor)
    • NativeAdViewCompose'da 3 farklı layoutId inflate ediliyordu

    YENİ YAKLAŞIM:
    • TEK dosya — adSize parametresi compose katmanında ViewGroup.LayoutParams ile çözülür
    • NativeAdViewCompose → mediaHeightDp: Int parametresi alır → bunu AndroidView'da uygular
    • LinearLayout → ConstraintLayout: iç içe 3 katman → 1 düz katman (measure pass azalır)

    KATMAN FARK:
    ESKİ: NativeAdView → LinearLayout(V) → LinearLayout(H) → LinearLayout(V) → TextView
    YENİ: NativeAdView → ConstraintLayout → direkt widget'lar
-->
<com.google.android.gms.ads.nativead.NativeAdView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_native_ad_card"
    android:padding="12dp">

    <!--
        ConstraintLayout: tüm widget'lar flat (tek katman) → measure pass azalır.
        LinearLayout nested structure → ConstraintLayout flat structure:
        Her view'ın constraints açık — bakımı kolay, performans daha iyi.
    -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- İkon: sol üst köşe -->
        <ImageView
            android:id="@+id/ad_app_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_ad_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <!--
            Başlık: ikon sağında, üst hizada.
            layout_marginEnd="20dp" — AdMob'un otomatik yerleştirdiği AdChoices ikonu
            (ADCHOICES_TOP_RIGHT, bkz. AdEngine.kt) sağ üst köşeye biner. Bu boşluk
            olmadan uzun reklam başlıkları ellipsize'a rağmen o alana çok yaklaşıp
            ikonun üstünü örtebilirdi — politika ihlali sayılabilecek bir durum.
        -->
        <TextView
            android:id="@+id/ad_headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/ad_headline_color"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintTop_toTopOf="@id/ad_app_icon"
            app:layout_constraintStart_toEndOf="@id/ad_app_icon"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- "Sponsorlu" badge: başlık altında -->
        <TextView
            android:id="@+id/ad_sponsored_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sponsorlu"
            android:textSize="8sp"
            android:textColor="@color/ad_badge_text"
            android:background="@drawable/bg_ad_badge"
            android:paddingHorizontal="4dp"
            android:paddingVertical="1dp"
            android:layout_marginTop="2dp"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toBottomOf="@id/ad_headline"
            app:layout_constraintStart_toEndOf="@id/ad_app_icon"/>

        <!-- Açıklama: ikon ve badge'in altında -->
        <TextView
            android:id="@+id/ad_body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/ad_body_color"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/ad_app_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!--
            MediaView: yüksekliği compose katmanından ViewGroup.LayoutParams ile set edilir.
            Default 0dp → görünmez. NativeAdViewCompose içinde mediaHeightDp parametresi
            bunu belirler. Bu sayede small/medium/large boyutu tek XML ile karşılanır.
        -->
        <!--
            MediaView: layout_height="wrap_content" — ConstraintLayout 0dp yüksekliği
            top/bottom constraint olmadan sıfır hesaplar, kod tarafı set etse bile etkisiz.
            wrap_content ile MediaView kendi içeriğine göre boyutlanır,
            kod tarafından minHeight ile minimum yükseklik garantilenir.
        -->
        <com.google.android.gms.ads.nativead.MediaView
            android:id="@+id/ad_media"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="120dp"
            android:layout_marginTop="8dp"
            android:scaleType="centerCrop"
            android:clipToOutline="true"
            app:layout_constraintTop_toBottomOf="@id/ad_body"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- CTA butonu: en altta -->
        <Button
            android:id="@+id/ad_call_to_action"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="@color/ad_cta_bg"
            android:stateListAnimator="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/ad_media"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.gms.ads.nativead.NativeAdView>
