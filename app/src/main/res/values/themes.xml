<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Heftreng" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">#2A1A4E</item>
        <item name="colorOnPrimaryContainer">@color/brand_accent</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorSurfaceVariant">@color/surface2</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">#333333</item>
        <item name="colorError">#EF4444</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Ripple rengi -->
        <item name="colorControlHighlight">#337C3AED</item>
    </style>

    <!-- Chip style -->
    <style name="Widget.Heftreng.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="android:textColor">@color/white</item>
        <item name="chipBackgroundColor">@color/surface2</item>
        <item name="chipStrokeColor">#444444</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedBackgroundColor">@color/brand_primary</item>
    </style>

    <!-- Bottom Sheet -->
    <style name="Widget.Heftreng.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="android:background">@color/surface</item>
    </style>

    <!-- TabLayout -->
    <style name="Widget.Heftreng.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabIndicatorColor">@color/brand_primary</item>
        <item name="tabSelectedTextColor">@color/white</item>
        <item name="tabTextColor">@color/text_secondary</item>
        <item name="android:background">@color/surface</item>
    </style>


    <style name="RoundedImage" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>


    <style name="TopRoundedImage" parent="">
        <item name="cornerFamilyTopLeft">rounded</item>
        <item name="cornerFamilyTopRight">rounded</item>
        <item name="cornerFamilyBottomLeft">none</item>
        <item name="cornerFamilyBottomRight">none</item>
        <item name="cornerSizeTopLeft">18dp</item>
        <item name="cornerSizeTopRight">18dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>


    <style name="BubbleSentShape" parent="">
        <item name="cornerFamilyTopLeft">rounded</item>
        <item name="cornerFamilyTopRight">rounded</item>
        <item name="cornerFamilyBottomLeft">rounded</item>
        <item name="cornerFamilyBottomRight">cut</item>
        <item name="cornerSizeTopLeft">14dp</item>
        <item name="cornerSizeTopRight">14dp</item>
        <item name="cornerSizeBottomLeft">14dp</item>
        <item name="cornerSizeBottomRight">2dp</item>
    </style>
    <style name="BubbleReceivedShape" parent="">
        <item name="cornerFamilyTopLeft">rounded</item>
        <item name="cornerFamilyTopRight">rounded</item>
        <item name="cornerFamilyBottomLeft">cut</item>
        <item name="cornerFamilyBottomRight">rounded</item>
        <item name="cornerSizeTopLeft">14dp</item>
        <item name="cornerSizeTopRight">14dp</item>
        <item name="cornerSizeBottomLeft">2dp</item>
        <item name="cornerSizeBottomRight">14dp</item>
    </style>

</resources>

