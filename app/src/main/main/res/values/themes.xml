<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Theme.Material3.DayNight.NoActionBar:
        - Material3 renk sistemi ile tam uyumlu
        - enableEdgeToEdge() ile sorunsuz çalışır
        - Compose statusBarColor / navigationBarColor Compose tarafından yönetilir
    -->
    <style name="Theme.Heftreng" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Edge-to-edge: sistem çubukları şeffaf, Compose içerik içine çizer -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
