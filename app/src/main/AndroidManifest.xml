<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- İnternet erişimi — zorunlu -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 13+ reklam kimliği izni — UMP/AdMob zorunlu -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <!-- Galeri erişimi — resim gönderme -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Bildirimler — Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Titreşim — bildirim titreşimi -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Ağ durumu — FCM WebChannel için -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Video okuma — ileride video özelliği için -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"
        android:minSdkVersion="33" />

    <!-- Ses dosyası okuma — ileride ses özelliği için -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"
        android:minSdkVersion="33" />

    <!-- ═══════════════════════════════════════════════════════════════════
         CİHAZ UYUMLULUĞU — "Bu cihaz desteklenmiyor" sorununu önler.

         tools:node="replace" kritik: AdMob, Firebase gibi kütüphaneler kendi
         manifest'lerinde aynı donanımı required="true" tanımlayabilir.
         Manifest merge sırasında kütüphanenin "true" değeri bizim "false"
         değerimizi ezebilir. tools:node="replace" bunu engeller:
         derleyiciye "kütüphanenin ne dediğini sil, sadece bu satırı kullan"
         der. Bu olmadan Play Store bazı cihazları listeden çıkarır.
         ═══════════════════════════════════════════════════════════════════ -->
    <uses-feature android:name="android.hardware.camera"            android:required="false" tools:node="replace" />
    <uses-feature android:name="android.hardware.camera.any"        android:required="false" tools:node="replace" />
    <uses-feature android:name="android.hardware.camera.autofocus"  android:required="false" tools:node="replace" />
    <uses-feature android:name="android.hardware.camera.front"      android:required="false" tools:node="replace" />
    <uses-feature android:name="android.hardware.camera.flash"      android:required="false" tools:node="replace" />
    <uses-feature android:name="android.hardware.microphone"        android:required="false" tools:node="replace" />
    <uses-feature android:name="android.hardware.location"          android:required="false" tools:node="replace" />
    <uses-feature android:name="android.hardware.location.gps"      android:required="false" tools:node="replace" />
    <uses-feature android:name="android.hardware.location.network"  android:required="false" tools:node="replace" />
    <uses-feature android:name="android.hardware.bluetooth"         android:required="false" tools:node="replace" />
    <uses-feature android:name="android.hardware.bluetooth_le"      android:required="false" tools:node="replace" />
    <uses-feature android:name="android.hardware.nfc"               android:required="false" tools:node="replace" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" tools:node="replace" />
    <uses-feature android:name="android.hardware.sensor.gyroscope"  android:required="false" tools:node="replace" />
    <uses-feature android:name="android.hardware.telephony"         android:required="false" tools:node="replace" />
    <uses-feature android:name="android.hardware.wifi"              android:required="false" tools:node="replace" />
    <uses-feature android:name="android.hardware.touchscreen"       android:required="false" tools:node="replace" />
    <uses-feature android:name="android.hardware.faketouch"         android:required="false" tools:node="replace" />
    <!-- OpenGL ES 2.0 satırı kaldırıldı — Play Store bunu bazen yanlış
         yorumlar; zaten tüm modern cihazlarda standart olarak bulunur -->

    <!-- Tüm ekran boyutları/yoğunlukları desteklensin -->
    <supports-screens
        android:smallScreens="true"
        android:normalScreens="true"
        android:largeScreens="true"
        android:xlargeScreens="true"
        android:anyDensity="true" />

    <application
        android:name=".HeftrangApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Heftreng"
        android:supportsRtl="true"
        android:theme="@style/Theme.Heftreng"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep link: heftreng://app/post/ID -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="heftreng" android:host="app" />
            </intent-filter>
        </activity>

        <!-- FCM Messaging Service -->
        <service
            android:name=".utils.HeftrangMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- FCM varsayılan bildirim kanalı -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="heftreng_default" />

        <!-- FCM bildirim ikonu -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notif" />

        <!-- FCM bildirim rengi -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notif_color" />

        <!-- Google Play Services versiyonu -->
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />

        <!-- AdMob App ID -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-6463746824939277~5046669508" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>
    </application>
</manifest>
